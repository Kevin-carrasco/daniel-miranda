  author = {Gonz{\'a}lez, Roberto and Lickel, Brian and Gupta, Manisha and Tropp, Linda R and Kanacri, Bernadette P Luengo and Mora, Eduardo and {De Tezanos-Pinto}, Pablo and Berger, Christian and Valdenegro, Daniel and Cayul, Oscar and Miranda, Daniel and Saavedra, Patricio and Bernardino, Michelle},
