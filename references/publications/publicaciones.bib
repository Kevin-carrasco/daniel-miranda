  shorttitle = {When Civic Knowledge Matters but Is Not Enough},
  author = {{Luengo-Kanacri}, Bernadette Paula and {Jim{\'e}nez-Moya}, Gloria and Miranda, Daniel and Marinovic, Alejandra},
